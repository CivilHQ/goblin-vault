#!/usr/bin/env bash
# Pre-push hook — Goblin Vault
# Build fex, health check, & full lint sebelum push ke remote.
# Di-install via scripts/install-hooks.sh (symlink ke .git/hooks).
set -euo pipefail

# Ensure Go toolchain is in PATH
if [[ -d "$HOME/.go/bin" ]]; then
  export PATH="$HOME/.go/bin:$PATH"
fi
if command -v go >/dev/null 2>&1; then
  GOPATH_BIN="$(go env GOPATH 2>/dev/null || true)/bin"
  if [[ -n "$GOPATH_BIN" && -d "$GOPATH_BIN" ]]; then
    export PATH="$PATH:$GOPATH_BIN"
  fi
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "🩺 goblin pre-push: running doctor (blocking)..."
if ! "$REPO_ROOT/scripts/doctor.js"; then
  echo "❌ doctor.js gagal — push dibatalkan. Pastikan dependency wajib terpasang." >&2
  exit 1
fi

# Build ke temp dir unik (hindari race kalau /tmp/fex dipakai bersamaan)
BUILD_DIR="$(mktemp -d)"
trap 'rm -rf "$BUILD_DIR"' EXIT
BIN="$BUILD_DIR/fex"

echo "🔨 goblin pre-push: building fex..."
if ! (cd "$REPO_ROOT/tools-cli/src/fex" && go build -o "$BIN" ./cmd/fex); then
  echo "❌ build fex gagal — push dibatalkan." >&2
  exit 1
fi

echo "🐙 goblin pre-push: running full syntax check..."
if ! "$REPO_ROOT/scripts/check_syntax.js" --full; then
  echo "❌ check_syntax.js gagal — push dibatalkan." >&2
  exit 1
fi

echo "✅ pre-push OK"
